{
    "apt": {
        "name": "apt",
        "description": "APT package manager (Debian/Ubuntu)",
        "inventory_cmd": "apt list --installed 2>/dev/null",
        "install_cmd": "apt-get install -y",
        "platforms": [
            "linux",
            "debian",
            "ubuntu"
        ],
        "os_check": "command -v apt-get &>/dev/null"
    },
    "brew": {
        "name": "brew",
        "description": "Homebrew package manager (macOS)",
        "inventory_cmd": "brew list 2>/dev/null",
        "install_cmd": "brew install",
        "platforms": [
            "macos",
            "darwin"
        ],
        "os_check": "command -v brew &>/dev/null"
    },
    "pip": {
        "name": "pip",
        "description": "Python package installer",
        "inventory_cmd": "pip list 2>/dev/null",
        "install_cmd": "pip install",
        "platforms": [
            "linux",
            "macos",
            "windows"
        ],
        "os_check": "command -v pip &>/dev/null"
    },
    "conda": {
        "name": "conda",
        "description": "Conda package manager",
        "inventory_cmd": "conda list 2>/dev/null",
        "install_cmd": "conda install -y",
        "platforms": [
            "linux",
            "macos",
            "windows"
        ],
        "os_check": "command -v conda &>/dev/null"
    },
    "webi": {
        "name": "webi",
        "description": "Webi installer (alternative installers)",
        "platforms": [
            "linux",
            "macos"
        ],
        "os_check": "command -v webi &>/dev/null"
    },
    "docker": {
        "name": "docker",
        "description": "Docker container image manager",
        "inventory_cmd": "docker images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null",
        "install_cmd": "docker pull",
        "platforms": [
            "linux",
            "macos",
            "windows"
        ],
        "os_check": "command -v docker &>/dev/null"
    },
    "source": {
        "name": "source",
        "description": "Source-based package installer",
        "inventory_cmd": "ls -1 ~/.pkgm/source_installs 2>/dev/null",
        "install_cmd": "source-install",
        "platforms": [
            "linux",
            "macos"
        ],
        "os_check": "command -v curl &>/dev/null && command -v tar &>/dev/null"
    },
    "snap": {
        "name": "snap",
        "description": "Snapcraft package manager",
        "inventory_cmd": "snap list | awk 'NR>1 {print $1}' 2>/dev/null",
        "install_cmd": "snap install",
        "platforms": ["linux"],
        "os_check": "command -v snap &>/dev/null"
    },
    "flatpak": {
        "name": "flatpak",
        "description": "Flatpak application distribution",
        "inventory_cmd": "flatpak list --app --columns=application 2>/dev/null",
        "install_cmd": "flatpak install -y",
        "platforms": ["linux"],
        "os_check": "command -v flatpak &>/dev/null"
    }
}
